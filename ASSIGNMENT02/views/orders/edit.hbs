<div class="row justify-content-center">
  <div class="col-md-6">
    <h1 class="mb-4">Edit Order</h1>
    <form action="/orders/{{order._id}}?_method=PUT" method="POST">
      <div class="mb-3">
        <label class="form-label">Drink</label>
        <select name="menuItem" class="form-select" required>
          {{#each menuItems}}
          <option value="{{this._id}}" {{#if (eq this._id ../order.menuItem._id)}}selected{{/if}}>
            {{this.name}} ({{formatPrice this.basePrice}})
          </option>
          {{/each}}
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Size</label>
        <select name="size" class="form-select">
          <option {{#if (eq order.size "Small")}}selected{{/if}}>Small</option>
          <option {{#if (eq order.size "Medium")}}selected{{/if}}>Medium</option>
          <option {{#if (eq order.size "Large")}}selected{{/if}}>Large</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Milk</label>
        <select name="milk" class="form-select">
          <option {{#if (eq order.milk "Whole")}}selected{{/if}}>Whole</option>
          <option {{#if (eq order.milk "Skim")}}selected{{/if}}>Skim</option>
          <option {{#if (eq order.milk "Oat")}}selected{{/if}}>Oat</option>
          <option {{#if (eq order.milk "Almond")}}selected{{/if}}>Almond</option>
          <option {{#if (eq order.milk "None")}}selected{{/if}}>None</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Extra Shots</label>
        <input type="number" name="extraShots" class="form-control" value="{{order.extraShots}}" min="0" max="4">
      </div>
      <button type="submit" class="btn brand-btn">Save Changes</button>
    </form>
  </div>
</div>