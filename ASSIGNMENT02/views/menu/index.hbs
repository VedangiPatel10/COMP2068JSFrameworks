<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Our Menu</h1>
  {{#if currentUser}}
    <a href="/menu/new" class="btn brand-btn-outline">+ Add Item</a>
  {{/if}}
</div>

{{#if items.length}}
<div class="row g-4">
  {{#each items}}
  <div class="col-md-4">
    <div class="card menu-card h-100">
      <img src="{{this.imagePath}}" class="card-img-top" alt="{{this.name}}">
      <div class="card-body">
        <span class="badge bg-secondary mb-2">{{this.category}}</span>
        <h5 class="card-title">{{this.name}}</h5>
        <p class="card-text text-muted">{{this.description}}</p>
        <p class="fw-bold">{{formatPrice this.basePrice}}</p>
        {{#if ../currentUser}}
          <a href="/orders/new" class="btn brand-btn btn-sm">Order This</a>
        {{/if}}
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<p class="text-muted">No menu items yet. {{#if currentUser}}<a href="/menu/new">Add the first one</a>.{{/if}}</p>
{{/if}}